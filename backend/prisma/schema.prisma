generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  ADMIN
}

model Client {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("clients")
}

model Job {
  id                   String   @id @default(uuid())
  name                 String   @unique
  minimumWorkMinutes   Int
  breakIsPaidByDefault Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users  User[]
  shifts Shift[]

  @@map("jobs")
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UserRole @default(EMPLOYEE)

  hourlyRateCents Int @default(0)

  currentJobId String
  currentJob   Job    @relation(fields: [currentJobId], references: [id], onDelete: Restrict)

  breakIsPaidOverride Boolean?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  googleId String? @unique

  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  emailVerified                   Boolean   @default(false)
  emailVerificationTokenHash      String?
  emailVerificationTokenExpiresAt DateTime?

  accountDeletionTokenHash      String?
  accountDeletionTokenExpiresAt DateTime?

  shifts          Shift[]
  payrollPayments PayrollPayment[]
  notifications   Notification[]

  shiftEditRequestsSubmitted ShiftEditRequest[] @relation("ShiftEditRequestedBy")
  shiftEditRequestsReviewed  ShiftEditRequest[] @relation("ShiftEditRequestReviewedBy")

  payrollReconciliations         PayrollReconciliation[] @relation("PayrollReconciliationEmployee")
  payrollReconciliationsResolved PayrollReconciliation[] @relation("PayrollReconciliationResolvedBy")

  @@map("users")
}

enum ShiftStatus {
  WORKING
  ON_BREAK
  COMPLETED
}

model Shift {
  id        String      @id @default(uuid())
  userId    String
  clockIn   DateTime
  clockOut  DateTime?
  status    ShiftStatus @default(WORKING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  jobId                       String
  job                         Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  minimumWorkMinutesAtClockIn Int

  autoClosed  Boolean @default(false)
  needsReview Boolean @default(false)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks       Break[]
  editRequests ShiftEditRequest[]

  @@index([userId])
  @@index([jobId])
  @@map("shifts")
}

enum ShiftEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ShiftEditRequest {
  id      String @id @default(uuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User   @relation("ShiftEditRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  proposedClockOut DateTime
  reason           String

  status ShiftEditRequestStatus @default(PENDING)

  reviewedByUserId String?
  reviewedBy       User?     @relation("ShiftEditRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote       String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([shiftId])
  @@index([status])
  @@map("shift_edit_requests")
}

model Break {
  id        String    @id @default(uuid())
  shiftId   String
  startTime DateTime
  endTime   DateTime?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("breaks")
}

enum ReconciliationStatus {
  PENDING
  CLEAN
  FLAGGED
  RESOLVED
}

model PayrollReconciliation {
  id         String @id @default(uuid())
  employeeId String
  employee   User   @relation("PayrollReconciliationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  periodFrom DateTime
  periodTo   DateTime

  systemRegularDurationMs  Float
  systemBreakDurationMs    Float
  systemOvertimeDurationMs Float

  clientRegularDurationMs  Float?
  clientBreakDurationMs    Float?
  clientOvertimeDurationMs Float?

  status ReconciliationStatus @default(PENDING)

  resolvedRegularDurationMs  Float?
  resolvedBreakDurationMs    Float?
  resolvedOvertimeDurationMs Float?

  resolutionReason String?

  resolvedByUserId String?
  resolvedBy       User?     @relation("PayrollReconciliationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollPayment PayrollPayment?

  @@unique([employeeId, periodFrom, periodTo])
  @@index([employeeId])
  @@index([status])
  @@map("payroll_reconciliations")
}

model PayrollPayment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodFrom DateTime
  periodTo   DateTime

  hourlyRateCents Int

  regularDurationMs          Float
  overtimeDurationMs         Float
  compensatedBreakDurationMs Float
  workedDurationMs Float
  grossPayCents    Int

  reconciliationId String?                 @unique
  reconciliation   PayrollReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  notifications Notification[]

  @@index([userId])
  @@map("payroll_payments")
}

enum NotificationType {
  SHIFT_EDIT_REQUEST_SUBMITTED
  SHIFT_EDIT_REQUEST_APPROVED
  SHIFT_EDIT_REQUEST_REJECTED
  PAYROLL_PAYMENT_RECORDED
  HOURLY_RATE_CHANGED
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  shiftEditRequestId String?
  shiftEditRequest   ShiftEditRequest? @relation(fields: [shiftEditRequestId], references: [id], onDelete: Cascade)

  payrollPaymentId String?
  payrollPayment   PayrollPayment? @relation(fields: [payrollPaymentId], references: [id], onDelete: Cascade)

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}
